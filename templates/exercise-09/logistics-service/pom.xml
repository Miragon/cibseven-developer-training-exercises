    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.miragon</groupId>
        <artifactId>cibseven-developer-training-exercises</artifactId>
        <version>1.0-SNAPSHOT</version>
        <!-- Correct once the module lives at services/logistics-service (its home after you copy it in
             Aufgabe 9): ../../pom.xml is the repo root. While it still sits under templates/ (only the CI
             check builds it there), CI installs the root pom first so the parent resolves from the repo. -->
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>logistics-service</artifactId>
    <name>logistics-service</name>

    <!--
      Aufgabe 9 – Skeleton des Logistik-Services (Remote-Owner des sendWelcomeKit-Prozesses).

      Fülle die TODO Aufgabe 9-Stellen:
        1. Den typisierten /engine-rest-Client generieren  -> der auskommentierte Plugin-Block unten.
        2. Die Client-Beans verdrahten                      -> EngineClientConfig.
        3. Das Modell selbst deployen                       -> EngineDeploymentAdapter.
        4. Den External-Task-Worker implementieren          -> ShipWelcomeKitWorker.
        5. Die Engine über den Client starten               -> RemoteWelcomeKitProcessAdapter.

      Referenzlösung: solutions/exercise-09/logistics-service.
    -->

    <properties>
        <!-- Package the generated /engine-rest client lands in (used once you enable the generator). -->
        <cibseven-client.package>org.cibseven.rest.client</cibseven-client.package>
    </properties>

    <dependencies>
        <!-- spring-web: RestClient (Deployment + generierter Client) + der kleine REST-Controller.
             Ein leichter HTTP-Server läuft auf :8090 (kollidiert nicht mit der Engine auf :8080). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- CIB Seven External Task Client (Richtung 1: Engine -> Worker) -->
        <dependency>
            <groupId>org.cibseven.bpm.springboot</groupId>
            <artifactId>cibseven-bpm-spring-boot-starter-external-task-client</artifactId>
        </dependency>
        <!-- Der generierte Client ist self-contained auf Jackson 2 (Spring Boot 4 nutzt Jackson 3),
             daher die Jackson-2-Artefakte + jakarta.annotation explizit (BOM-verwaltete Versionen). -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <!-- Runtime-Typen der bpmn-to-code generierten Process-API -->
        <dependency>
            <groupId>io.miragon</groupId>
            <artifactId>bpmn-to-code-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

