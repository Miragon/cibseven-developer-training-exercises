<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>io.miragon</groupId>
    <artifactId>cibseven-developer-training-exercises</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>cibseven-developer-training-exercises</name>

    <modules>
        <module>exercise</module>
        <module>solutions</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <postgresql.version>42.7.8</postgresql.version>
        <cib7.version>2.2.0</cib7.version>
        <archunit.version>1.4.2</archunit.version>
    </properties>

    <!--
      Nur Versions-Verwaltung – erzwingt KEINE Dependencies. Jedes Modul wählt selbst,
      welche Deps es zieht (ohne Version); Spring-Boot-Deps managt der Parent.
    -->
    <dependencyManagement>
        <dependencies>
            <!-- CIB Seven (direct – no process-engine-api abstraction) -->
            <!-- '-4' suffixed artifacts are the Spring Boot 4 compatible variants (since CIB seven 2.2.0) -->
            <dependency>
                <groupId>org.cibseven.bpm.springboot</groupId>
                <artifactId>cibseven-bpm-spring-boot-starter-webapp-4</artifactId>
                <version>${cib7.version}</version>
            </dependency>
            <dependency>
                <groupId>org.cibseven.bpm.springboot</groupId>
                <artifactId>cibseven-bpm-spring-boot-starter-rest-4</artifactId>
                <version>${cib7.version}</version>
            </dependency>
            <!-- Architecture tests -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Spring Boot fat-jar packaging – declared here so child modules can reference it without version -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.springframework.boot</groupId>
                                <artifactId>spring-boot-devtools</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <repositories>
        <repository>
            <id>mvn-cibseven-enterprise-snapshots</id>
            <name>CIB seven EE Snapshots repository</name>
            <url>https://artifacts.cibseven.org/repository/enterprise-snapshots</url>
        </repository>
    </repositories>

</project>
